    "__handleKnxdOutage": {
      "jsdoc": {
        "raw": [
          "*",
          "     * Handle a response that reports a lost connection of the backend to knxd.",
          "     * The backend itself is reachable, so the connection must stay alive, only",
          "     * the read requests have to be repeated until knxd is back. As there is no",
          "     * long-poll wait while knxd is gone (nothing can arrive), the requests are",
          "     * throttled here.",
          "     *",
          "     * @param response {Object|String} body of the failed response",
          "     "
        ],
        "@description": [
          {
            "name": "@description",
            "body": "<p>Handle a response that reports a lost connection of the backend to knxd.\n The backend itself is reachable, so the connection must stay alive, only\n the read requests have to be repeated until knxd is back. As there is no\n long-poll wait while knxd is gone (nothing can arrive), the requests are\n throttled here.</p>"
          }
        ],
        "@param": [
          {
            "name": "@param",
            "body": "response {Object|String} body of the failed response",
            "paramName": "response",
            "description": " body of the failed response",
            "type": [
              "Object",

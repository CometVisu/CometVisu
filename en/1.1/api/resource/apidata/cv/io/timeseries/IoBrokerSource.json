  "className": "cv.io.timeseries.IoBrokerSource",
  "jsdoc": {
    "raw": [
      "*",
      " * Time series source for the ioBroker backend. In contrast to the other sources the",
      " * data is not fetched from an URL, it is requested over the already established backend",
      " * connection, therefore the builtin fetching is disabled and fetchData() is used.",
      " *",
      " * The resource url is <code>iobroker://&lt;state.id&gt;</code>, the backend connection to",
      " * use can be named in front of it: <code>iobroker://&lt;backend&gt;@&lt;state.id&gt;</code>.",
      " "
    ],
    "@description": [
      {
        "name": "@description",
        "body": "<p>Time series source for the ioBroker backend. In contrast to the other sources the\n data is not fetched from an URL, it is requested over the already established backend\n connection, therefore the builtin fetching is disabled and fetchData() is used.\n The resource url is <code>iobroker://&amp;lt;state.id&amp;gt;</code>, the backend connection to\n use can be named in front of it: <code>iobroker://&amp;lt;backend&amp;gt;@&amp;lt;state.id&amp;gt;</code>.</p>"
      }
    ]
  },
